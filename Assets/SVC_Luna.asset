            = u_xlat2.yyy * hlslcc_mtx4x4unity_ObjectToWorld[1].xyz;\n        u_xlat5.xyz
            = u_xlat5.xyz + u_xlat6.xyz;\n        u_xlat6.xyz = u_xlat1.xxx * hlslcc_mtx4x4unity_ObjectToWorld[2].xyz;\n       
            u_xlat5.xyz = u_xlat5.xyz + u_xlat6.xyz;\n        u_xlat1.xyw = u_xlat1.yyy
            * hlslcc_mtx4x4unity_ObjectToWorld[3].xyz;\n        u_xlat1.xyw = u_xlat1.xyw
            + u_xlat5.xyz;\n        u_xlat1.xyw = u_xlat1.xyw;\n        u_xlat1.xyw
            = (-u_xlat1.xyw);\n        u_xlat1.xyw = u_xlat1.xyw + _WorldSpaceCameraPos.xyz;\n       
