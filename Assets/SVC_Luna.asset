            u_xlat10;\nfloat u_xlat11;\nmediump vec3 u_xlat16_15;\nmediump vec3 u_xlat16_16;\nmediump
            float u_xlat16_17;\nfloat u_xlat20;\nfloat u_xlat21;\nmediump float u_xlat16_27;\nfloat
            u_xlat30;\nfloat u_xlat31;\nmediump float u_xlat16_36;\nvoid main()\n{\n   
            u_xlat0.x = dot(vs_TEXCOORD1.xyz, vs_TEXCOORD1.xyz);\n    u_xlat0.x =
